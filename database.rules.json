{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/hostId').val() === auth.uid) || (data.child('meta/hostId').val() === auth.uid && !newData.exists()))",

        "meta": {
          ".write": "auth != null && data.parent().child('meta/hostId').val() === auth.uid",
          "hostId": {
            ".write": "auth != null && (data.val() === auth.uid || (newData.val() === auth.uid && data.parent().parent().child('players').child(data.val()).child('connected').val() !== true && data.parent().parent().child('players').child(auth.uid).child('connected').val() === true))",
            ".validate": "newData.isString()"
          },
          "phase": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'board' || newData.val() === 'minigameIntro' || newData.val() === 'minigame' || newData.val() === 'minigameResult' || newData.val() === 'gameEnd'"
          },
          "maxTurns": { ".validate": "newData.isNumber() && newData.val() > 0" }
        },

        "board": {
          ".write": "auth != null && data.parent().child('meta/hostId').val() === auth.uid"
        },

        "minigame": {
          ".write": "auth != null && data.parent().child('meta/hostId').val() === auth.uid"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || data.parent().parent().child('meta/hostId').val() === auth.uid)",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8" },
            "colorIdx": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "order": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "connected": { ".validate": "newData.isBoolean()" },
            "coins": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === data.val() || (!data.exists() && newData.val() === 0) || newData.parent().parent().parent().child('meta/hostId').val() === auth.uid)"
            },
            "stars": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === data.val() || (!data.exists() && newData.val() === 0) || newData.parent().parent().parent().child('meta/hostId').val() === auth.uid)"
            },
            "pos": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === data.val() || (!data.exists() && newData.val() === 0) || newData.parent().parent().parent().child('meta/hostId').val() === auth.uid)"
            }
          }
        },

        "inputs": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || data.parent().parent().child('meta/hostId').val() === auth.uid)"
          }
        }
      }
    }
  }
}
